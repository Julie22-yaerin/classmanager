# Firebase client config (public — safe to expose in the browser bundle;
# access is controlled by Firestore Security Rules + Firebase Auth, not secrecy).
# Get these from Firebase Console -> Project settings -> General -> Your apps -> Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OpenRouter — server-side only, SECRET, never exposed to the client.
# "main" does the core reasoning (chat, exam mode, playbook, daily mode, class routing).
# "perception" does OCR (image/PDF) and audio transcription.
OPENROUTER_MAIN_API_KEY=
OPENROUTER_PERCEPTION_API_KEY=

# Public site URL, used for metadata/OG image/sitemap. Update if you attach a custom domain.
NEXT_PUBLIC_SITE_URL=https://classmanager-production-75e7.up.railway.app

# Optional — Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Leave unset to skip
# analytics entirely (no cookie banner shown either, since there'd be nothing to consent to).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
