// DRM v0.3 — School AI data model

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  subject   String
  classes   Class[]
  createdAt DateTime @default(now())
}

model Class {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  grade     String
  subject   String
  textbook  String?

  // --- Class Memory ---
  curriculum         String? // running summary of what's been covered
  teacherPersona     String? // how the teacher behaves/communicates
  teachingStyle      String?
  questionStyle      String?
  assessmentPatterns String?
  topicPriorities    String? // JSON array of {topic, weight, reason}
  importantDates     String? // JSON array of {title, date, source}

  materials    Material[]
  messages     ChatMessage[]
  deadlines    Deadline[]
  examReports  ExamReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id            String   @id @default(cuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  tag           String // Homework | PastExam | ClassRecording | Material | Notes | TeacherAnnouncement
  title         String?
  sourceType    String // text | image | pdf | audio
  rawContent    String? // original text / transcript
  extractedText String? // parsed/derived text used for indexing
  topic         String?
  analysis      String? // JSON blob (exam breakdown, extracted deadlines, etc.)
  fileName      String?
  mimeType      String?
  fileData      String? // base64, MVP inline storage
  createdAt     DateTime @default(now())
}

model ChatMessage {
  id         String   @id @default(cuid())
  classId    String?
  class      Class?   @relation(fields: [classId], references: [id])
  role       String // user | assistant
  tag        String? // required tag on user messages
  mode       String? // daily | exam
  content    String
  fileName   String?
  materialId String?
  createdAt  DateTime @default(now())
}

model Deadline {
  id         String    @id @default(cuid())
  classId    String
  class      Class     @relation(fields: [classId], references: [id])
  title      String
  dueDate    DateTime?
  sourceType String // announcement | recording
  notes      String?
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
}

model ExamReport {
  id               String   @id @default(cuid())
  classId          String
  class            Class    @relation(fields: [classId], references: [id])
  topicPriority    String // JSON
  patternAnalysis  String // JSON
  markDistribution String // JSON
  weakAreas        String // JSON
  mockExam         String
  reviewSheet      String
  createdAt        DateTime @default(now())
}

model StudentProfile {
  id                  String   @id @default(cuid())
  academicLevel       String?
  explanationStyle    String?
  communicationStyle  String?
  learningPreferences String?
  weaknesses          String? // running notes on recurring mistakes
  updatedAt           DateTime @updatedAt
}
