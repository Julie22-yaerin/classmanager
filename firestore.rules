rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's data lives under users/{uid} and its subcollections
    // (teachers, classes, materials, messages, deadlines, examReports).
    // A signed-in user may only read/write their own tree.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
