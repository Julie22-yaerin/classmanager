rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's data lives under users/{uid} and its subcollections
    // (classes, materials, messages, deadlines, examReports, teacherSimulations).
    // A signed-in user may only read/write their own tree. Writes are also
    // capped in size so a compromised or malicious client can't stuff huge
    // blobs into Firestore directly (client SDK writes bypass the Next.js
    // API layer entirely, so limits belong here too, not just server-side).
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function withinSize(field, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string && request.resource.data[field].size() <= maxLen);
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid) && withinSize('weaknesses', 5000) && withinSize('academicLevel', 1000);

      match /classes/{classId} {
        allow read, write: if isOwner(uid) &&
          withinSize('teacherName', 200) &&
          withinSize('curriculum', 20000) &&
          withinSize('teacherPersona', 5000) &&
          withinSize('teachingStyle', 5000) &&
          withinSize('questionStyle', 5000) &&
          withinSize('assessmentPatterns', 5000);
      }

      match /materials/{materialId} {
        allow read, write: if isOwner(uid) &&
          withinSize('rawContent', 20000) &&
          withinSize('extractedText', 20000);
      }

      match /messages/{messageId} {
        allow read, write: if isOwner(uid) && withinSize('content', 20000);
      }

      match /deadlines/{deadlineId} {
        allow read, write: if isOwner(uid) && withinSize('title', 500) && withinSize('notes', 2000);
      }

      match /examReports/{reportId} {
        allow read, write: if isOwner(uid) && withinSize('mockExam', 30000) && withinSize('reviewSheet', 30000);
      }

      match /teacherSimulations/{simulationId} {
        allow read, write: if isOwner(uid);
      }

      match /classUpdates/{updateId} {
        allow read, write: if isOwner(uid) && withinSize('topic', 200) && withinSize('reason', 2000);
      }

      match /patternReports/{reportId} {
        allow read, write: if isOwner(uid) && withinSize('summary', 5000) && withinSize('strategicImplication', 5000) && withinSize('caveat', 2000);
      }

      match /predictions/{predictionId} {
        allow read, write: if isOwner(uid) && withinSize('claim', 2000) && withinSize('resolutionNote', 2000);
      }

      // Evidence-scoring engine: raw typed observations (evidenceSignals) and
      // the deterministic scores computed from them per topic (topicStates).
      match /evidenceSignals/{signalId} {
        allow read, write: if isOwner(uid) &&
          withinSize('rawEvidence', 2000) &&
          withinSize('normalizedEvidence', 500) &&
          withinSize('topicLabel', 200);
      }

      match /topicStates/{topicStateId} {
        allow read, write: if isOwner(uid) && withinSize('topicLabel', 200);
      }

      // Reference Room: AI-suggested study resources, filed by class/topic/time.
      match /referenceItems/{referenceItemId} {
        allow read, write: if isOwner(uid) &&
          withinSize('title', 300) &&
          withinSize('description', 1000) &&
          withinSize('searchQuery', 500) &&
          withinSize('topic', 200);
      }

      // Private markers of which shared groupSignals/{fingerprint} docs this
      // user has contributed to, so account deletion can clean those up too.
      match /groupContributionRefs/{fingerprint} {
        allow read, write: if isOwner(uid);
      }
    }

    // Group Intelligence: shared, cross-student aggregate signals. Deliberately
    // outside users/{uid} — any signed-in user may read (the whole point is
    // combining signal across accounts) and write the shared metadata doc, but
    // only the contributing user may write their own contribution. Only
    // topic + weight numbers are stored here, never reasons, evidence, or any
    // other class/material content — contributing is opt-in from Settings.
    match /groupSignals/{fingerprint} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        withinSize('teacherName', 200) && withinSize('subject', 200) && withinSize('grade', 50);

      match /contributions/{contributorId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == contributorId;
      }
    }
  }
}
